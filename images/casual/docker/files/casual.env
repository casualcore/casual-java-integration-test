#!/bin/env bash

set -e
# Source this file to allow command line operations of casual.
# e.g.
# source casual.env

# By default the container is logging to STDOUT, this allows logging
# via kubectl logs.
# However, it makes it not possible to run casual cli as it uses
# STDIN and STDOUT which would clash.

# Therefore we change the logging in the current session to allow casual cli
# to work as expected.
export CASUAL_LOG_PATH=''

# The following are non-essential preferences.

source /opt/casual/etc/bash_completion.d/casual

PS1='\[\e[38;5;39m\]\w\[\e[0m\] \[\e[1;31m\]\$\[\e[0m\] '

alias ls='ls --color=auto'